{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luy-blog-dev",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luyblog-local",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "luyblog-media-local"
    }
  ],
  "vars": {
    "APP_BASE_URL": "http://localhost:5173",
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1"
  },
  "env": {
    "production": {
      "name": "luy-blog",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "luyblog_prod",
          "database_id": "556a28d9-10d5-48b4-b711-015085b2ee0a",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "luyblog-media"
        }
      ],
      "vars": {
        "APP_BASE_URL": "https://blog.lyuy.top",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGSqT0xbUXcp6fcg",
        "TURNSTILE_HOSTNAMES": "blog.lyuy.top"
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
